{
  "_about": "5.5 polygon area and cost. Path specs resolve through _task5_helpers.resolve. Assumed inputs carry a schema. Area is level (a). Nothing here speaks to wells.",
  "seed": 20261105,
  "match_iou": 0.3,
  "merge_overlap_frac": 0.2,
  "subtract_pits": true,
  "road_buffer_m": 3.0,
  "road_window_m": 30.0,
  "reference": "survey",
  "boundary_definition": "disturbed",
  "bootstrap_B": 2000,
  "boundary_sample_m": 1.0,
  "decision": {"tolerances": [0.15, 0.25, 0.40], "primary_tolerance": 0.25, "area_share_f": null, "delta_area_fallback": 0.2231},
  "redraw": {"n_pads": 30, "size_terciles": true},
  "monte_carlo": {"draws": 10000, "portfolio_n": [10, 50], "default_condition_class": "unknown"},
  "inputs": {
    "pad_products": {"path": "@results_9t/pad/thresholds/pad_heldout_found_vs_missed_thr0p50_9t.gpkg", "layer": "model_geometry",
                     "hint": "Built by notebooks/wellsight_v2/s5_eval/_pad_threshold_products_9t.py. Held-out pad polygons at 0.50."},
    "annotations": {"path": "@truth/annotations_proj.gpkg", "hint": "Layers plat, pit_inside, roads"},
    "pad_blocks": {"path": "@nine_t/pad_blocks_9t.gpkg", "hint": "375 m CV blocks"},
    "pad_cover": {"path": "@results_9t/pad/pad_cover_split_9t.gpkg", "hint": "Canopy cover class per pad_id"},
    "by_pad": {"path": "@exp:5.5/results/tables/pad_area_by_pad_9t.csv", "hint": "Run _padarea_by_pad_9t.py (S1)."},
    "redraws": {"path": "@exp:5.5/data/raw/pad_redraw_reviewers_9t.gpkg", "assumed": true,
                "schema": {"layers": "reviewer_a, reviewer_b", "pad_id": "int, from the redraw sheet", "geometry": "Polygon EPSG:6346"},
                "hint": "Two reviewers redraw the 30 sampled pads blind to model polygons and each other. User-only step."},
    "survey": {"path": "@data/_source/pad_survey/pad_outlines_survey.gpkg", "assumed": true,
               "schema": {"pad_id": "int (annotation pad_id) or survey id with pad_id column", "definition": "disturbed | graded | as_walked", "method": "RTK | drone_gcp", "h_acc_m": "float", "survey_date": "YYYY-MM-DD", "digitiser": "str (drone outlines are digitised twice)", "geometry": "Polygon, any CRS, transformed to EPSG:6346"},
               "hint": "Field GNSS or drone outlines (fw_5_5 section 5). Proposed path data/_source/pad_survey/. None held."},
    "reference_area": {"path": "@exp:5.5/data/processed/pad_reference_area_9t.csv", "hint": "Run _padarea_survey_ingest_9t.py (S3)."},
    "cost_table": {"path": "@reference/cost/restoration_cost_table.csv", "assumed": true,
                   "schema": {"item": "fixed_per_well | area_restoration | road_restoration", "condition_class": "for fixed_per_well, e.g. unknown, shallow, deep", "unit": "USD per well | USD per m2 | USD per m", "low": "float", "high": "float", "year": "int", "basis": "str (PA DEP, federal program)"},
                   "hint": "Agency cost table with a separable area term. Proposed path data/_source/reference/cost/. None held."}
  },
  "outputs": {
    "by_pad": "@exp:5.5/results/tables/pad_area_by_pad_9t.csv",
    "tile_decomp": "@exp:5.5/results/tables/pad_area_tile_decomposition_9t.json",
    "redraw_sheet": "@exp:5.5/data/interim/pad_redraw_sample_sheet_9t.csv",
    "redraw_agreement": "@exp:5.5/results/tables/pad_redraw_agreement_9t.csv",
    "reference_area": "@exp:5.5/data/processed/pad_reference_area_9t.csv",
    "agreement": "@exp:5.5/results/tables/pad_area_agreement_9t.csv",
    "agreement_summary": "@exp:5.5/results/tables/pad_area_agreement_summary_9t.json",
    "cost_error": "@exp:5.5/results/tables/pad_cost_error_9t.csv",
    "cost_summary": "@exp:5.5/results/tables/pad_cost_error_summary_9t.json",
    "cost_fig": "@exp:5.5/results/figures/pad_cost_error_9t.png"
  }
}
