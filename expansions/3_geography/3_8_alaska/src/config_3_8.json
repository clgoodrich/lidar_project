{
  "exp_id": "3.8",
  "written": "2026-11-05 by the build agent. Every radar and permafrost source is assumed (VERIFY). Edit freely.",
  "prereg": {
    "primary_estimand": "E2. Median over sites of (well-site long-term LOS rate minus matched-control mean), mm/yr, two-sided around delta",
    "delta_mm_yr": null,
    "multiplicity": {"method": "holm", "family": ["E2_rate_mm_yr"], "max_undefined": 0.0,
                     "_note": "User default 2026-11-06 (take defaults). Holm over declared primaries. E2 is the one primary, so Holm equals the unadjusted gate. E3, the placebo and the permutation band are reported, never gated. delta stays a user decision."},
    "los_sign": "positive toward the satellite",
    "wavelength_m": {"sentinel1_c": 0.05546576, "nisar_l": 0.2385, "alos2_l": 0.2425, "_verify": "c over centre frequency, check against mission specs"},
    "mission": "sentinel1_c",
    "site_cluster_m": 300,
    "control_exclusion_m": 2000,
    "n_controls_per_site": 3,
    "match_exact": ["landcover", "ice_class", "slope_class"],
    "match_continuous": ["wetness", "road_dist_m"],
    "pad_side_m_default": 100,
    "postings_m": {"sentinel1_c": 40, "sentinel1_hyp3_80": 80, "nisar_gslc": 5, "nisar_gunw": 80},
    "min_acq_per_season": 6,
    "thaw_months": [5, 6, 7, 8, 9],
    "end_of_season_month": 9,
    "coherence_min": 0.35,
    "closure_max_rad": 0.5,
    "inject_amplitudes_mm_yr": [2, 5, 10, 20],
    "inject_seasonal_mm": [5, 10, 20],
    "B": 2000,
    "master_seed": 3800
  },
  "inputs": {
    "legacy_wells": {"path": {"key": "reference", "rel": "wells_ak/ak_legacy_wells_blm.csv"},
      "schema": {"WellName": "str", "API": "str", "Status": "str", "SpudDate": "date", "Latitude": "float NAD83", "Longitude": "float", "CoordSource": "str", "PadType": "str", "PlugStatus": "str"},
      "verify": "Obtain the federal legacy list and the AOGCC well database. Count wells, pads, clusters within 300 m. Compare with the 12 and 44 held USGS rows"},
    "aogcc_wells": {"path": {"key": "reference", "rel": "wells_ak/ak_aogcc_wells.csv"},
      "schema": {"Api": "str", "WellName": "str", "Status": "str", "Lat": "float", "Lon": "float"}},
    "control_candidates": {"path": {"area": "ak1", "rel": "derived/ak_control_candidates_ak1.csv"},
      "schema": {"cand_id": "str", "lon": "float", "lat": "float", "landcover": "int NLCD-AK class", "ice_class": "str", "slope_class": "str", "wetness": "float", "road_dist_m": "float", "frame": "str radar frame id"},
      "verify": "Sample points on a grid in the same ecoregion and frame, attach covariates from permafrost, ice, land cover, IfSAR slope and road layers"},
    "site_covariates": {"path": {"area": "ak1", "rel": "derived/ak_site_covariates_ak1.csv"},
      "schema": {"site_id": "str", "landcover": "int", "ice_class": "str", "slope_class": "str", "wetness": "float", "road_dist_m": "float", "frame": "str", "pad_area_m2": "float from IfSAR orthoimage"}},
    "acquisitions": {"path": {"area": "ak1", "rel": "derived/ak_acquisitions_ak1.csv"},
      "schema": {"frame": "str", "date": "date", "mission": "str", "track": "int", "polarisation": "str", "url": "str"},
      "verify": "ASF archive search per site. Count acquisitions per thaw season and year"},
    "ifg_manifest": {"path": {"area": "ak1", "rel": "derived/ak_stack_ak1/ifg_manifest_ak1.csv"},
      "schema": {"date1": "date", "date2": "date", "unw_tif": "path (unwrapped phase, rad)", "corr_tif": "path (coherence 0-1)", "wrapped_tif": "path optional"},
      "verify": "HyP3-style products on one frame, same grid, EPSG:3338 or UTM 6/7"},
    "weather_flags": {"path": {"area": "ak1", "rel": "derived/ak_weather_flags_ak1.csv"},
      "schema": {"date": "date", "frame": "str", "snow": "bool", "wet_melt": "bool", "flood": "bool"}},
    "active_layer": {"path": {"area": "ak1", "rel": "derived/ak_active_layer_sites_ak1.csv"},
      "schema": {"site": "str", "lon": "float", "lat": "float", "year": "int", "thaw_depth_cm": "float", "subsidence_cm": "float optional"}}
  },
  "areas": {"ak1": {"crs": "EPSG:3338"}}
}
