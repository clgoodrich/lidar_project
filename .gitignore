# WellSight .gitignore
#
# Rewritten 2026-08-12 for the area-major layout. The previous file had ~280
# lines and roughly 60 rules anchored to paths that Phase 4F moved. A rule that
# points at a directory which no longer exists fails SILENTLY -- it stops
# protecting anything, and the next commit puts a 100 MB raster into history
# forever. The pre-rewrite file is kept at
# docs/_ledgers/gitignore_pre_area_major.bak.
#
# THE POLICY IS SET BY ROLE, NOT BY PATH.
#
#   <area>/derived/     regenerable by definition   -> ignored, records negated back
#   <area>/models/      weights and prob rasters    -> ignored; manifests/logs kept
#   <area>/results/     small, and the deliverable  -> TRACKED, no rule
#   qgis/annotations/   hand-drawn, irreplaceable   -> TRACKED, no rule
#   data/_source/       raw input, re-downloadable  -> ignored
#   data/_archive/      parked and superseded       -> ignored, manifest force-added
#
# Audit after anything that writes large outputs (must print nothing):
#   find . -type f -size +100M -not -path './.git/*' -not -path './.venv/*' | \
#     while read f; do git check-ignore -q "$f" || echo "LEAKING: $f"; done

# --- derived: every raster under any area, at any depth --------------------
data/**/derived/**
!data/**/derived/**/
!data/**/derived/**/_PROVENANCE.json
!data/**/derived/**/*.md
!data/**/derived/**/*.json
!data/**/derived/**/*.csv
!data/**/derived/**/*_preview.png
!data/**/derived/**/*_quicklook.png

# --- models: a bundle. Keep the record, drop the weights and the rasters. --
data/**/models/**/*.pt
data/**/models/**/*.pth
data/**/models/**/*.tif
data/**/models/**/*.tif.aux.xml
data/**/models/**/*.npz
data/**/models/**/dataset/
data/**/models/**/run/
data/_pretrained/

# --- experiments: notes and metrics in, rasters out ------------------------
# Both a shared _experiments/ and a per-area <area>/experiments/ exist, so the
# rule has to match at any depth rather than anchoring to the shared one. Gate A
# caught exactly that: 9t/experiments/exag3x/ leaked three rasters through a
# rule written only for data/_experiments/.
data/**/experiments/**/*.tif
data/**/experiments/**/*.tif.aux.xml
data/**/experiments/**/*.npz
data/**/experiments/**/*.pt
data/**/experiments/**/*.gpkg
# `data/**/experiments/` needs a component literally named "experiments", which
# the shared `_experiments` (underscore) does not match. Both spellings listed.
data/_experiments/**/*.tif
data/_experiments/**/*.tif.aux.xml
data/_experiments/**/*.gpkg
data/_experiments/**/*.npz
data/_experiments/**/*.pt
# `data/**/experiments/` needs a component literally named "experiments", which
# the shared `_experiments` (underscore) does not match. Both spellings listed.
data/_experiments/**/*.tif
data/_experiments/**/*.tif.aux.xml
data/_experiments/**/*.gpkg
data/_experiments/**/*.npz
data/_experiments/**/*.pt.aux.xml
data/_experiments/**/*.npz
data/_experiments/**/*.pt

# --- source: raw input, all of it re-downloadable --------------------------
data/_source/**
!data/_source/**/
!data/_source/**/*.md
!data/_source/**/*.txt
!data/_source/**/*.csv

# --- archive: bulk out, manifest in ----------------------------------------
data/_archive/**
!data/_archive/ARCHIVE_MANIFEST.csv
!data/_archive/README.md

# --- annotations are TRACKED. Only the snapshots' rasters are not. ---------
# qgis/annotations/ carries the one thing in this repository no script can
# rebuild, so it has no ignore rule at all. _history/ holds dated snapshots,
# and _backup_pit_ann426_2026-06-10 happens to contain a full model run.
qgis/annotations/_history/**/*.tif
qgis/annotations/_history/**/*.tif.aux.xml
qgis/annotations/_history/**/*.pt
qgis/*.qgz.*.bak

# GDAL statistics sidecars. Regenerated on demand by GDAL/QGIS, so they are
# never worth tracking -- 7 of them were the only current files the 2026-08-13
# history rewrite removed.
*.tif.aux.xml
*.tif.ovr

# --- point clouds anywhere, always large -----------------------------------
*.las
*.laz
*.copc.laz
*.h5
!tests/fixtures/*.las
!tests/fixtures/*.laz

# --- legacy trees still on disk --------------------------------------------
archive/derivatives/**/*.tif
archive/derivatives/**/*.tif.aux.xml
archive/derivatives/**/*.gpkg
archive/derivatives/**/*.npz
archive/derivatives/**/*.pt

# --- large reference PDFs (re-downloadable) --------------------------------
docs/papers/Allegheny-Oil.pdf
docs/papers/annas-arch-784c7616f171.pdf
barlow/docs/BARLOW-DISSERTATION-2026*.pdf
barlow/docs/BARLOW-DISSERTATION-2026_readalong.epub
barlow/Shapefiles/
barlow/MDV_Resources.docx

# --- build scratch ---------------------------------------------------------
data/**/_build_*.log
data/**/_tmp_*.json
data/**/_tmp_intensity_tiles_*/
*.gpkg-wal
*.gpkg-shm
backup_to_E*.log

# --- Python / IDE / OS -----------------------------------------------------
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.vscode/
*.code-workspace
Thumbs.db
.DS_Store
~$*
.claude/worktrees/
*.zip
