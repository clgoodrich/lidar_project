# Data files (too large for git)
data/files/*.las
data/files/*.laz
data/files/*.copc.laz
data/files/older_files/
data/files/mcKean/
data/files/seperate sections/
data/external/lidar/*/laz/
data/external/lidar/**/*.laz
data/external/lidar/**/*.las
data/derivatives/*.tif
data/derivatives/*.png
data/derivatives/9t/*.tif
data/derivatives/9t/*.png
data/derivatives/9t/*.gpkg
data/derivatives/9t/*.pt
data/derivatives/9t/*.csv
data/derivatives/9t/*.json
data/derivatives/9t/*.las
data/derivatives/9t/*.laz
data/derivatives/9t/pit_unet_v2/
data/derivatives/9t/plat_unet/
data/derivatives/9t/road_classifier/
data/derivatives/9t/road_unet/
data/derivatives/model_archive/*.gpkg

# Keep annotations and candidate GPKGs (small)
!data/derivatives/annotations/

# Keep iteration metrics + train logs + run logs (small; large rasters/checkpoints excluded below)
!data/derivatives/9t/iterations/
!data/derivatives/9t/iterations/**/
data/derivatives/9t/iterations/**/*.pt
data/derivatives/9t/iterations/**/*.tif
data/derivatives/9t/iterations/**/*.png

# Land cover data
nlcd_*/
landcover_*/
PA_LandCover/
OilGasLocations_*/
EnviroAtlas_*

# Zips
*.zip

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# IDE
.vscode/
*.code-workspace

# OS
Thumbs.db
.DS_Store

# Large files (>100 MB) not covered by patterns above
data/full_dem.tif
data/derivatives/_output3_covar.las
data/derivatives/pit_1m_candidates_ensemble.gpkg
data/files/OilGasLocations/

# LAZ/LAS point clouds anywhere (always large)
*.las
*.laz
*.copc.laz

# ...except small synthetic test fixtures (a few KB each)
!tests/fixtures/*.laz
!tests/fixtures/*.las

# External data downloads (NAIP chips, USGS 3DEP tiles, paper bundles)
data/external/ramachandran_2024/naip_chips/
data/external/ramachandran_2024/naip_chips_pilot/
data/external/ramachandran_2024/permian_denver_data.zip
data/external/usgs_3dep_permian_tx/laz_pilot_A/
data/external/usgs_3dep_permian_tx/tile_inventory.parquet
data/external/usgs_3dep_permian_tx/tiles_intersecting_pads.parquet
data/external/usgs_3dep_pa_lidar/

# Ramachandran verifier training outputs (model weights, prob arrays)
data/derivatives/ramachandran_verifier/verifier_best.pt
data/derivatives/ramachandran_verifier/verifier_last.pt
data/derivatives/ramachandran_verifier/index.csv
data/derivatives/ramachandran_verifier/*_probs*.npz

# Pilot A LiDAR derivatives (1m rasters per tile)
data/derivatives/pilot_A/*.tif

# Road-extract pipeline rasters (score/mask, ~100-200 MB each at 10k x 10k)
data/derivatives/roads/*.tif

# Beck replication rasters (rl, canopy_class, etc. — can hit 100MB at 10k)
data/derivatives/beck_*/*.tif

# Per-tile temp intensity rasters (PDAL outputs during build)
data/derivatives/_tmp_intensity_tiles_*/

# Statewide ancillary (PA O&G locations shapefile, PA land cover)
# Patterns above (OilGasLocations_*/ and PA_LandCover/) already cover new
# data/external/ locations since they have no anchor.
# Legacy archived data dumps
data/external/legacy_data/

# Claude
.claude/worktrees/

# Office lock files
~$*
